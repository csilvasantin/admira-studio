    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
